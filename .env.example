# Compose / app runtime
COMPOSE_PROJECT_NAME=ai-studyplatform
APP_ENV=local
APP_TIMEZONE=Australia/Sydney

# Gateway and service ports, all these internal ports are not required to change. But external ports may have to change if there are conflicts on the host machine.
NGINX_PORT=8080                                                 # May have to Change
PUBLIC_FRONTEND_PORT=8080                                       # May have to Change
FRONTEND_PORT=5173                                              # May have to Change
IDENTITY_PORT=8000                                              # May have to Change
AI_SERVICE_PORT=8001                                            # May have to Change
COMMUNICATION_PORT=8002                                         # May have to Change
LEARNING_PORT=8003                                              # May have to Change
REDIS_PORT=6379                                                 # May have to Change
REDIS_INTERNAL_PORT=6379
QUIZ_REDIS_PORT=6380                                            # May have to Change
QUIZ_REDIS_INTERNAL_PORT=6379
MINIO_API_PORT=9000                                             # May have to Change
MINIO_CONSOLE_PORT=9001                                         # May have to Change

# Cloudflare Quick Tunnel target. Leave TUNNEL_PORT blank to use NGINX_PORT.
TUNNEL_MODE=local
TUNNEL_TARGET_HOST=127.0.0.1
TUNNEL_PORT=

# Frontend and internal service URLs
VITE_API_BASE_URL=/api
IDENTITY_SERVICE_URL=http://identity-service:8000
AI_SERVICE_URL=http://ai-service:8001
COMMUNICATION_SERVICE_URL=http://communication-service:8002
LEARNING_SERVICE_URL=http://learning-service:8003
PUBLIC_BASE_URL=http://localhost:8080/api
PUBLIC_FRONTEND_URL=http://localhost:8080
INTERNAL_API_TOKEN=change_me_internal_api_token                 # Have to Change

# JWT configuration
JWT_SECRET_KEY=replace_with_a_random_64_char_hex_string         # Have to Change
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# MySQL configuration
MYSQL_ROOT_PASSWORD=change_me_root_password                     # Have to Change    
MYSQL_SHARED_USER=platform_reader                               # Have to Change
MYSQL_SHARED_PASSWORD=change_me_platform_reader_password        # Have to Change
MYSQL_INTERNAL_PORT=3306
MYSQL_PORT=3306                                                 # May have to Change
# If your local 3306 is already in use, change MYSQL_PORT to another value such as 3307.

# MySQL-backed service databases
IDENTITY_DB_HOST=mysql
IDENTITY_DB_NAME=identity_db                                    # Could Change
IDENTITY_DB_USER=identity_user                                  # Could Change
IDENTITY_DB_PASSWORD=change_me_identity_password                # Could Change
COMMUNICATION_DB_HOST=mysql
COMMUNICATION_DB_NAME=communication_db                          # Could Change    
COMMUNICATION_DB_USER=communication_user                        # Could Change       
COMMUNICATION_DB_PASSWORD=change_me_communication_password      # Could Change
LEARNING_DB_HOST=mysql
LEARNING_DB_NAME=learning_db                                    # Could Change
LEARNING_DB_USER=learning_user                                  # Could Change
LEARNING_DB_PASSWORD=change_me_learning_password                # Could Change

# PostgreSQL configuration for AI service
AI_DB_HOST=postgres-ai
AI_DB_NAME=learning_platform_ai                                 # Could Change
AI_DB_USER=ai_user                                              # Could Change
AI_DB_PASSWORD=change_me_ai_password                            # Could Change
AI_DB_PORT=5432
AI_DB_EXTERNAL_PORT=5433                                        # May have to Change

# AI settings
AI_EMBEDDING_PROVIDER=gemini
AI_EMBEDDING_ORCHESTRATOR=langchain
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_OUTPUT_DIMENSION=1536
AI_EMBEDDING_TASK_TYPE=RETRIEVAL_DOCUMENT
AI_EMBEDDING_VERSION=gemini-embedding-001@1536
AI_EMBEDDING_BATCH_SIZE=16
AI_EMBEDDING_API_KEY=
AI_CHUNK_SIZE_CHARS=1200
AI_CHUNK_OVERLAP_CHARS=200
AI_CHAT_PROVIDER=gemini
AI_CHAT_MODEL=gemini-2.5-flash-lite
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_ORCHESTRATOR=langchain
AI_INDEX_JOB_MAX_AUTO_RETRIES=3
AI_INDEX_JOB_RETRY_BASE_SECONDS=30
AI_INDEX_JOB_RETRY_MAX_SECONDS=900
AI_INDEX_JOB_RUNNING_TIMEOUT_SECONDS=1800
AI_INDEX_JOB_REAPER_INTERVAL_SECONDS=60
GEMINI_API_KEY=your-gemini-api-key                              # Have to Change
# Optional local DeepSeek key for the OpenAI-compatible chat provider adapter.
DEEPSEEK_API_KEY=
AI_DEMO_MODEL_NAME=gemini-2.5-flash-lite                        # Could Change

# Redis / Celery
REDIS_HOST=redis
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_DEFAULT_QUEUE=ai.default
IDENTITY_CELERY_TASK_DEFAULT_QUEUE=identity.default
COMMUNICATION_CELERY_TASK_DEFAULT_QUEUE=communication.notifications
LEARNING_CELERY_TASK_DEFAULT_QUEUE=learning.quiz
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
LANGGRAPH_CHECKPOINT_ENABLED=true
LANGGRAPH_CHECKPOINT_REDIS_URL=redis://redis:6379/1
LANGGRAPH_CHECKPOINT_KEY_PREFIX=ai.langgraph
QUIZ_GENERATION_RUN_REDIS_URL=redis://redis:6379/2
QUIZ_GENERATION_RUN_KEY_PREFIX=ai.quiz_generation
QUIZ_GENERATION_RUN_TTL_SECONDS=3600
QUIZ_REDIS_HOST=redis-quiz
QUIZ_REDIS_DB=0
QUIZ_REDIS_URL=redis://redis-quiz:6379/0
QUIZ_ATTEMPT_SESSION_GRACE_SECONDS=300
QUIZ_ATTEMPT_SESSION_FALLBACK_TTL_SECONDS=7200
QUIZ_ATTEMPT_SUBMIT_LOCK_SECONDS=60
QUIZ_ATTEMPT_COUNTER_TTL_SECONDS=2592000

# Learning file storage
LEARNING_MATERIAL_ROOT=/app/storage/materials
LEARNING_MATERIAL_PUBLIC_BASE_URL=/api/learning/materials
LEARNING_MATERIAL_AI_QUEUE=ai.material.index

# Object storage (MinIO)
OBJECT_STORAGE_PROVIDER=local
MINIO_ENDPOINT=http://minio:9000                                # Have to Change if MinIO Port is changed
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=learning-materials
AI_PROFILE_BUCKET=ai-profile-assets
MINIO_PUBLIC_BASE_URL=http://localhost:8080/learning-materials  # Have to Change if NGINX_PORT or PUBLIC_FRONTEND_PORT is changed
MINIO_SIGNED_URL_EXPIRES_SECONDS=300
MINIO_MULTIPART_PART_URL_EXPIRES_SECONDS=3600

# Email configuration for identity-service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com                             # Have to Change
SMTP_PASS=your-smtp-app-password                                # Have to Change
SMTP_FROM=your_email@example.com                             # Have to Change    
SMTP_TLS=true
DEFAULT_ADMIN_EMAIL=admin@example.com                        # Local demo admin login; change before public deployment
DEFAULT_ADMIN_PASSWORD=DemoAdmin123!                          # Local demo admin password; change before public deployment
DEFAULT_ADMIN_FULL_NAME=Demo Admin                            # Local demo admin name; change before public deployment
